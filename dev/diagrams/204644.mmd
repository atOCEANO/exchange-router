flowchart LR
    C("<b>Your code</b>")
    R{"<b>Router</b>"}
    L["<b>local</b><br/>adapters in this process"]
    V["<b>service</b><br/>one container, shared"]
    D["One adapter per exchange,<br/>one normalized schema"]
    A[("Exchange A")]
    B[("Exchange B")]
    X[("Exchange C")]

    %% the Your code to Router edge carries no label: the two ranks sit adjacent,
    %% so mermaid had nowhere to put one and drew it touching both nodes
    %% forward only. 204647 records what happens otherwise: a node drawn as both a
    %% source and a sink has two ranks to satisfy, and mermaid resolves it by
    %% throwing the return edges back across the whole image. the return path is
    %% carried by the node labels instead of by edges
    C --> R
    R -- "Router.local(...)" --> L
    R -- "Router.service(url, ...)" --> V
    L --> D
    V -- "HTTP" --> D
    D --> A
    D --> B
    D --> X

    classDef entry fill:#16232e,stroke:#4d9feb,stroke-width:2px,color:#e6edf3
    classDef stage fill:#16232e,stroke:#2ee6a6,stroke-width:2px,color:#e6edf3
    class C entry
    class R,L,V,D,A,B,X stage
